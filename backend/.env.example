# =========================
# App
# =========================
PORT=4000
# Frontend origin (Next.js dev runs on 4001)
APP_URL=http://localhost:4001
API_URL=http://localhost:4000
# Optional: comma-separated CORS origins (overrides APP_URL list)
# CORS_ORIGINS=http://localhost:4001,http://localhost:3000
NODE_ENV=development
# development = no automatic polling (avoids duplicating prod tasks on shared DB/Redis)
# production  = scheduler + workers poll integrations
APP_MODE=development

# =========================
# Database (Supabase Postgres)
# =========================
# Use the connection-pooled URL for runtime, direct URL for migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/connector
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/connector
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# =========================
# Redis / BullMQ
# =========================
REDIS_URL=redis://localhost:6379

# =========================
# Encryption (AES-256-GCM)
# 64-character hex string (32 bytes).
# Generate with: bun -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
# =========================
ENCRYPTION_KEY=

# =========================
# Groq (LLM inference)
# =========================
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# =========================
# Google (Calendar + Gmail share one OAuth app)
# =========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/oauth/google/callback

# =========================
# Slack
# =========================
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/oauth/slack/callback

# =========================
# Jira (Atlassian)
# =========================
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:4000/api/oauth/jira/callback
# Optional: tune JQL (defaults: To Do + In Progress, max 50 issues)
# JIRA_MAX_RESULTS=50
# JIRA_STATUS_CATEGORIES=To Do,In Progress
# JIRA_EXTRA_JQL=

# =========================
# Discord
# =========================
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/api/oauth/discord/callback

# =========================
# Polling
# =========================
# 5 minutes by default. Only runs when APP_MODE=production.
POLLING_INTERVAL_MS=300000

# =========================
# Web Push (VAPID)
# Generate keys: npx web-push generate-vapid-keys
# =========================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:brief@localhost
PUSH_BATCH_DELAY_MS=30000

# Morning digest push (daily open-task summary)
MORNING_DIGEST_ENABLED=true
MORNING_DIGEST_HOUR=8
MORNING_DIGEST_MINUTE=0
# Fallback when User.timezone is not set
MORNING_DIGEST_TIMEZONE=America/New_York
