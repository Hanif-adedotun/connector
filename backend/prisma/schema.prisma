// Prisma schema for Connector v1
// See architecture.md for the full database design.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String   @id
  email                String   @unique
  firstName            String?  @map("first_name")
  notificationsEnabled Boolean  @default(true) @map("notifications_enabled")
  createdAt            DateTime @default(now()) @map("created_at")

  integrations      Integration[]
  events            ConnectorEvent[]
  tasks             ExtractedTask[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

enum Provider {
  google_calendar
  gmail
  slack
  jira
  discord
}

enum IntegrationStatus {
  active
  disconnected
  error
}

model Integration {
  id                    String            @id @default(uuid())
  userId                String            @map("user_id")
  provider              Provider
  encryptedAccessToken  String            @map("encrypted_access_token")
  encryptedRefreshToken String?           @map("encrypted_refresh_token")
  scope                 String?
  status                IntegrationStatus @default(active)
  lastPolledAt          DateTime?         @map("last_polled_at")
  jiraCloudId           String?           @map("jira_cloud_id")
  jiraSiteUrl           String?           @map("jira_site_url")
  createdAt             DateTime          @default(now()) @map("created_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pollingJobs PollingJob[]

  @@unique([userId, provider])
  @@index([userId])
  @@map("integrations")
}

model ConnectorEvent {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  provider     Provider
  externalId   String   @map("external_id")
  eventType    String   @map("event_type")
  title        String?
  content      String
  metadataJson Json?    @map("metadata_json")
  occurredAt   DateTime @map("occurred_at")
  processed    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks ExtractedTask[]

  @@unique([provider, externalId])
  @@index([userId, processed])
  @@map("connector_events")
}

enum TaskStatus {
  open
  done
  dismissed
}

model ExtractedTask {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  sourceEventId String?    @map("source_event_id")
  provider      Provider
  title         String
  summary       String?
  dueDate       DateTime?  @map("due_date")
  confidence    Float
  status        TaskStatus @default(open)
  createdAt     DateTime   @default(now()) @map("created_at")

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceEvent ConnectorEvent? @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("extracted_tasks")
}

enum PollingJobStatus {
  queued
  running
  succeeded
  failed
}

model PollingJob {
  id            String           @id @default(uuid())
  integrationId String           @map("integration_id")
  status        PollingJobStatus @default(queued)
  startedAt     DateTime?        @map("started_at")
  completedAt   DateTime?        @map("completed_at")
  error         String?

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, status])
  @@map("polling_jobs")
}
