# Backend API base URL. The frontend never talks to providers directly.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase (public values; safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Push — must match backend VAPID_PUBLIC_KEY
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Set to true to disable the service worker in local dev
# SERWIST_DISABLE=true

# Injected at build time from package.json (query persist buster).
# NEXT_PUBLIC_APP_VERSION=0.1.4
