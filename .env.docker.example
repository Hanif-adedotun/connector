# Copy to .env in the repo root before: docker compose up --build
#
# Production URLs (brief.hanif.one)
#   Frontend: https://brief.hanif.one        → container :4001 (reverse-proxy on host)
#   Backend:  https://brief.hanif.one:4000   → container :4000
#
# Redis runs in a separate container — set REDIS_URL to its host/port.

# --- Build args (baked into the Next.js bundle) ---
NEXT_PUBLIC_API_URL=https://brief.hanif.one:4000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Backend runtime ---
PORT=4000
APP_URL=https://brief.hanif.one
API_URL=https://brief.hanif.one:4000
NODE_ENV=production
APP_MODE=production

# Supabase Postgres (pooled URL for runtime)
DATABASE_URL=
# Direct URL for Prisma migrations (non-pooled)
DIRECT_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# External Redis container
REDIS_URL=redis://host.docker.internal:6379

ENCRYPTION_KEY=

GROQ_API_KEY=
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://brief.hanif.one:4000/api/oauth/google/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://brief.hanif.one:4000/api/oauth/slack/callback

JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=https://brief.hanif.one:4000/api/oauth/jira/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://brief.hanif.one:4000/api/oauth/discord/callback

POLLING_INTERVAL_MS=300000

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:brief@hanif.one
PUSH_BATCH_DELAY_MS=30000
